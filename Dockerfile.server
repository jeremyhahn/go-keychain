# Multi-stage Dockerfile for go-xkms unified server
# Supports all protocols: REST, gRPC, QUIC, MCP
# Production-ready with security best practices

# Stage 1: Builder
FROM golang:1.26.1-bookworm AS builder

# Allow Go to automatically download the required toolchain version
ENV GOTOOLCHAIN=auto

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    tzdata \
    gcc \
    libc6-dev \
    pkg-config \
    # USB support (google/gousb → phone backend)
    libusb-1.0-0-dev \
    # PKCS#11 support
    libsofthsm2 \
    softhsm2 \
    opensc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy go module files for better layer caching
COPY go.mod go.sum ./
COPY sdk/go/go.mod sdk/go/go.sum ./sdk/go/

# Download dependencies
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build the server with all backend tags enabled
# CGO_ENABLED=1 required for PKCS#11 support
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -buildvcs=false \
    -tags "pkcs8,tpm2,awskms,gcpkms,azurekv,vault,pkcs11" \
    -ldflags="-w -s -X main.version=${VERSION:-dev} -X main.commit=${COMMIT:-unknown} -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /build/xkmsd \
    ./cmd/xkmsd/

# Verify binary was built
RUN test -f /build/xkmsd || (echo "ERROR: Server binary not built" && exit 1)

# Stage 2: Runtime
FROM alpine:latest

LABEL maintainer="go-xkms"
LABEL description="Production xkms server supporting REST, gRPC, QUIC, and MCP protocols"
LABEL org.opencontainers.image.source="https://github.com/jeremyhahn/go-xkms"
LABEL org.opencontainers.image.description="Unified xkms server with all protocol support"
LABEL org.opencontainers.image.vendor="go-xkms"

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    libusb \
    softhsm \
    opensc \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Create required directories
RUN mkdir -p /app /etc/xkms /var/lib/xkms /data && \
    chown -R appuser:appuser /app /etc/xkms /var/lib/xkms /data

# Copy binary from builder
COPY --from=builder --chown=appuser:appuser /build/xkmsd /app/xkmsd

# Switch to non-root user
USER appuser

# Set working directory
WORKDIR /app

# Expose all protocol ports
# REST: 8443 (HTTPS)
# gRPC: 9443 (TLS)
# QUIC: 8444 (UDP)
# MCP: 9444 (TLS)
EXPOSE 8443 9443 8444/udp 9444

# Health check - check if REST API is responding
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider https://localhost:8443/health || exit 1

# Volume for persistent data
VOLUME ["/var/lib/xkms", "/etc/xkms"]

# Environment variables
ENV KEYSTORE_CONFIG=/etc/xkms/config.yaml

# Set entrypoint
ENTRYPOINT ["/app/xkmsd"]

# Default command (can be overridden)
CMD ["--config", "/etc/xkms/config.yaml"]
