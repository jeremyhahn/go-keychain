[Unit]
Description=xKMS Daemon - Unified Key Management Service
Documentation=https://github.com/jeremyhahn/go-xkms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xkms
Group=xkms

# Main service
ExecStart=/usr/bin/xkmsd --config /etc/xkms/xkmsd.yaml

# Reload configuration on SIGHUP
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Directories
RuntimeDirectory=xkms
RuntimeDirectoryMode=0750
StateDirectory=xkms
StateDirectoryMode=0750
ConfigurationDirectory=xkms
ConfigurationDirectoryMode=0750
LogsDirectory=xkms
LogsDirectoryMode=0750

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xkms /var/run/xkms
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
